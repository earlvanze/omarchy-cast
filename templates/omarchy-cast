#!/usr/bin/python3
import fcntl, hashlib, html, json, os, subprocess, sys, urllib.request, urllib.parse
from pathlib import Path
import xml.etree.ElementTree as ET
import urllib.error
STATE=Path.home()/'.local/state/video-cast'
STATE.mkdir(parents=True,exist_ok=True)
TARGET=json.loads((STATE/'target.json').read_text()) if (STATE/'target.json').exists() else None
URL='http://@LAN_IP@:18794/tv.mp4'
def notify(message):
 subprocess.run(['notify-send','Cast video',message],check=False)
def soap(action, _render=False, **args):
 if TARGET is None:raise RuntimeError('Choose a receiver from the cast button first.')
 service=TARGET.get('render_service') if _render else TARGET['service']
 endpoint=TARGET.get('render_control') if _render else TARGET['control']
 if not endpoint or not service:raise RuntimeError('Volume control is not available on this receiver.')
 fields=''.join(f'<{k}>{html.escape(str(v))}</{k}>' for k,v in {'InstanceID':0,**args}.items())
 body=f'<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body><u:{action} xmlns:u="{service}">{fields}</u:{action}></s:Body></s:Envelope>'
 req=urllib.request.Request(endpoint,data=body.encode(),headers={'Content-Type':'text/xml','SOAPAction':f'"{service}#{action}"'})
 return urllib.request.urlopen(req,timeout=4).read()
def stop():
 try:soap('Stop')
 except urllib.error.HTTPError as exc:
  # A renderer with no loaded media can reject Stop with transition code 701.
  body=exc.read()
  try:code=next((node.text for node in ET.fromstring(body).iter() if node.tag.split('}')[-1]=='errorCode'),None)
  except ET.ParseError:raise exc
  if code!='701':raise exc

def fields(data):
 return {node.tag.split('}')[-1]: node.text or '' for node in ET.fromstring(data).iter()}

def seconds(text):
 try:
  h,m,s=text.split(':');return int(int(h)*3600+int(m)*60+float(s))
 except (ValueError,AttributeError):return 0

def timestamp(value):
 value=max(0,int(value));return f'{value//3600:02}:{value//60%60:02}:{value%60:02}'

def playback(command, value=None):
 if command=='status':
  transport=fields(soap('GetTransportInfo'))
  result={'ok':True,'name':TARGET['name'],'state':transport.get('CurrentTransportState','UNKNOWN'),'position':0,'duration':0,'volume':None,'muted':None}
  try:
   position=fields(soap('GetPositionInfo'));result.update(position=seconds(position.get('RelTime')),duration=seconds(position.get('TrackDuration')))
  except Exception:pass
  if TARGET.get('render_control'):
   try:
    result['volume']=int(fields(soap('GetVolume',_render=True,Channel='Master'))['CurrentVolume'])
    result['muted']=fields(soap('GetMute',_render=True,Channel='Master'))['CurrentMute']=='1'
   except Exception:pass
  return result
 if command=='toggle':
  state=fields(soap('GetTransportInfo')).get('CurrentTransportState')
  soap('Pause') if state=='PLAYING' else soap('Play',Speed=1)
 elif command=='play':soap('Play',Speed=1)
 elif command=='pause':soap('Pause')
 elif command=='stop':stop()
 elif command in ('seek','skip','restart'):
  info=fields(soap('GetPositionInfo'));duration=seconds(info.get('TrackDuration'))
  target=0 if command=='restart' else float(value)
  if command=='skip':target+=seconds(info.get('RelTime'))
  target=max(0,min(target,max(0,duration-1))) if duration else max(0,target)
  soap('Seek',Unit='REL_TIME',Target=timestamp(target))
  if command=='restart':soap('Play',Speed=1)
 elif command=='volume':soap('SetVolume',_render=True,Channel='Master',DesiredVolume=max(0,min(100,int(value))))
 elif command=='mute':
  muted=fields(soap('GetMute',_render=True,Channel='Master'))['CurrentMute']=='1'
  soap('SetMute',_render=True,Channel='Master',DesiredMute=0 if muted else 1)
 else:raise ValueError('Unknown playback command')
 return {'ok':True}

def main():
 global TARGET
 arg=sys.argv[1] if len(sys.argv)>1 else '--status'
 if arg=='--control':
  try:
   request=json.loads(sys.argv[2])
   if request.get('target'):
    candidate=request['target']
    import ipaddress
    if ipaddress.ip_address(candidate['ip']) not in ipaddress.ip_network('@LAN_NETWORK@'):raise ValueError('Receiver outside LAN')
    for key in ['control','render_control']:
     if candidate.get(key) and (urllib.parse.urlparse(candidate[key]).hostname!=candidate['ip'] or urllib.parse.urlparse(candidate[key]).scheme!='http'):raise ValueError('Invalid receiver endpoint')
    TARGET=candidate
   print(json.dumps(playback(request.get('command','status'),request.get('value'))))
  except Exception as exc:
   message=str(exc)
   if isinstance(exc,urllib.error.HTTPError):
    try:
     fault=fields(exc.read());message='Receiver rejected command: '+fault.get('errorDescription','unsupported action')+' ('+fault.get('errorCode',str(exc.code))+')'
    except Exception:pass
   print(json.dumps({'ok':False,'error':message}))
  return
 if arg=='--status':
  print(soap('GetTransportInfo').decode());return
 if arg=='--stop':
  stop();notify('Playback stopped.');return
 with (STATE/'prepare.lock').open('w') as lock:
  try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except BlockingIOError:notify('A video is already being prepared.');return
  if len(sys.argv)>2:
   new=json.loads(sys.argv[2])
   import ipaddress
   if ipaddress.ip_address(new['ip']) not in ipaddress.ip_network('@LAN_NETWORK@') or urllib.parse.urlparse(new['control']).hostname!=new['ip'] or urllib.parse.urlparse(new['control']).scheme!='http' or new['service']!='urn:schemas-upnp-org:service:AVTransport:1':raise RuntimeError('Invalid LAN device.')
   known=STATE/'firewall-devices.json'
   allowed=json.loads(known.read_text()) if known.exists() else []
   if new['ip'] not in allowed:
    notify('Approve the administrator prompt to allow this receiver to fetch video.')
    result=subprocess.run(['pkexec','/usr/bin/ufw','allow','from',new['ip'],'to','@LAN_IP@','port','18794','proto','tcp','comment','LAN video casting'],capture_output=True,text=True)
    if result.returncode:raise RuntimeError('Firewall access was not approved.')
    allowed.append(new['ip']);known.write_text(json.dumps(allowed))
   TARGET=new
   (STATE/'target.json').write_text(json.dumps(TARGET))
  if arg=='--restart':
   active=STATE/'active.mp4'
   if not active.exists():raise RuntimeError('Choose a video first.')
   stop()
  else:
   source=Path(urllib.parse.unquote(urllib.parse.urlparse(arg).path) if arg.startswith('file:') else arg).resolve()
   if not source.is_file():raise RuntimeError('Video file not found.')
   probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_format','-show_streams','-of','json',str(source)]))
   video=next((s for s in probe['streams'] if s['codec_type']=='video'),None)
   if not video:raise RuntimeError('This file has no video track.')
   # Reuse a compatible, low-bandwidth MP4; optimize all other sources.
   bitrate=int(probe['format'].get('bit_rate',0))
   audio=[s for s in probe['streams'] if s['codec_type']=='audio']
   compatible=(source.suffix.lower()=='.mp4' and video['codec_name']=='h264' and video.get('pix_fmt')=='yuv420p' and 0<bitrate<=5500000 and video.get('width',0)<=1920 and video.get('height',0)<=1080 and all(s['codec_name']=='aac' for s in audio))
   selected=source
   if not compatible:
    key=hashlib.sha256(f'{source}:{source.stat().st_size}:{source.stat().st_mtime_ns}'.encode()).hexdigest()[:16]
    selected=STATE/f'optimized-{key}.mp4'
    if not selected.exists():
     notify('Preparing a smaller 1080p playback copy…')
     temp=STATE/f'optimized-{key}.part.mp4'
     with (STATE/'encode.log').open('w') as log:
      subprocess.run(['ffmpeg','-nostdin','-hide_banner','-loglevel','warning','-y','-i',str(source),'-map','0:v:0','-map','0:a:0?','-vf','scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2,fps=30','-c:v','libx264','-preset','veryfast','-crf','22','-maxrate','5M','-bufsize','10M','-pix_fmt','yuv420p','-threads','8','-c:a','aac','-b:a','160k','-movflags','+faststart',str(temp)],stdout=log,stderr=log,check=True)
     temp.replace(selected)
   # Stop the old stream before changing its backing file.
   stop()
   link=STATE/'active.new'
   link.unlink(missing_ok=True);link.symlink_to(selected);link.replace(STATE/'active.mp4')
   (STATE/'last.json').write_text(json.dumps({'source':str(source),'playback':str(selected)}))
  subprocess.run(['systemctl','--user','restart','video-cast.service'],check=True)
  import time
  for attempt in range(30):
   try:
    urllib.request.urlopen(urllib.request.Request(URL,method='HEAD'),timeout=1).close();break
   except OSError:time.sleep(.1)
  else:raise RuntimeError('Video server did not start.')
  soap('SetAVTransportURI',CurrentURI=URL,CurrentURIMetaData='')
  soap('Play',Speed=1)
  notify('Playing on '+TARGET['name']+'.')
if __name__=='__main__':
 try:main()
 except Exception as exc:
  notify(f'Could not cast: {exc}');print(str(exc),file=sys.stderr);sys.exit(1)
